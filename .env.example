# Copia este archivo como .env y completa los valores. .env nunca se sube a git.
APP_ENV=local

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=grifo2
DB_USER=root
DB_PASS=

# Token de la API de consulta DNI/RUC (decolecta.com)
DECOLECTA_TOKEN=

# Minutos de inactividad antes de cerrar la sesión
SESSION_MINUTOS=60

# Carpeta del registro de errores (por defecto, registros/ dentro del proyecto, sin acceso web)
# LOG_DIR=

# Clave de 64 caracteres hexadecimales para cifrar secretos guardados desde la interfaz.
# Generar con: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Modo demostración: 1 bloquea usuarios, roles, menú, configuración, auditoría, análisis,
# facturación, chatbot y personal, incluso para el administrador (ver config/demo.php).
# Solo en el servidor de la demo. No confundir con GRIFO_DEMO de Docker, que solo carga datos de ejemplo.
MODO_DEMO=0
