      "css": ".ds-btn-primario{font-family:Inter,system-ui,-apple-system,'Segoe UI',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 20px;border-radius:6px;font-size:.875rem;font-weight:500;cursor:pointer;transition:background-color .15s,color .15s,border-color .15s;background:#18181b;color:#fff;border:1px solid #18181b;} .ds-btn-primario:hover{background:#27272a;border-color:#27272a;} .ds-btn-primario:focus-visible{outline:2px solid #2563eb;outline-offset:2px;} .ds-btn-primario:disabled{opacity:.6;pointer-events:none;}"
    },
    {
